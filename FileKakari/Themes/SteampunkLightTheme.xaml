    <Color x:Key="TabBackgroundColor">#EEDAC9</Color>
    <Color x:Key="TabSelectedBackgroundColor">#FDFCFC</Color>
    <Color x:Key="TabHoverBackgroundColor">#F4F3F0</Color>
    <Color x:Key="TabSeparatorColor">#AAA092</Color>
    <Color x:Key="TextColor">#25221D</Color>
    <Color x:Key="SubtleTextColor">#645B4F</Color>
    <Color x:Key="BorderColor">#D1AD7B</Color>
    <Color x:Key="GridLineColor">#E8E6E3</Color>
