    <Color x:Key="ControlHoverColor">#EFEBE7</Color>
    <Color x:Key="ControlPressedColor">#E3DCD1</Color>
    <Color x:Key="ControlDisabledColor">#F1F0EF</Color>
    <Color x:Key="HeaderBackgroundColor">#F4EAE1</Color>
    <Color x:Key="HeaderHoverColor">#E9E5DF</Color>
    <Color x:Key="HeaderGripColor">#A3998A</Color>
