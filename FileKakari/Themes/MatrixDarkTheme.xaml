    <Color x:Key="RowBackgroundColor">#102517</Color>
    <Color x:Key="RowHoverColor">#28392C</Color>
    <Color x:Key="TabBackgroundColor">#08190E</Color>
    <Color x:Key="TabSelectedBackgroundColor">#29322C</Color>
    <Color x:Key="TabHoverBackgroundColor">#324637</Color>
    <Color x:Key="TabSeparatorColor">#637E69</Color>
    <Color x:Key="TextColor">#EEF2EF</Color>
    <Color x:Key="SubtleTextColor">#AFC0B3</Color>
    <Color x:Key="BorderColor">#308846</Color>
