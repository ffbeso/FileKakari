<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- オーシャン / Dark; generated by tools/generate_themes.py -->
    <Color x:Key="AppBackgroundColor">#14191A</Color>
    <Color x:Key="PanelBackgroundColor">#1D2323</Color>
    <Color x:Key="ControlBackgroundColor">#242D2E</Color>
    <Color x:Key="ControlHoverColor">#2D4143</Color>
    <Color x:Key="ControlPressedColor">#37585B</Color>
    <Color x:Key="ControlDisabledColor">#222728</Color>
    <Color x:Key="HeaderBackgroundColor">#232B2C</Color>
    <Color x:Key="HeaderHoverColor">#2D3F41</Color>
    <Color x:Key="HeaderGripColor">#637B7E</Color>
