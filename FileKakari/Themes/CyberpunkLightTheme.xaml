    <Color x:Key="TabBackgroundColor">#D8C9EE</Color>
    <Color x:Key="TabSelectedBackgroundColor">#FDFCFD</Color>
    <Color x:Key="TabHoverBackgroundColor">#F3F0F4</Color>
    <Color x:Key="TabSeparatorColor">#A492AA</Color>
    <Color x:Key="TextColor">#231D25</Color>
    <Color x:Key="SubtleTextColor">#5F4F64</Color>
    <Color x:Key="BorderColor">#7BC9D1</Color>
