    <Color x:Key="TabBackgroundColor">#181713</Color>
    <Color x:Key="TabSelectedBackgroundColor">#322F29</Color>
    <Color x:Key="TabHoverBackgroundColor">#463F32</Color>
    <Color x:Key="TabSeparatorColor">#7E7463</Color>
    <Color x:Key="TextColor">#F2F0EE</Color>
