    <Color x:Key="RowHoverColor">#2F2839</Color>
    <Color x:Key="TabBackgroundColor">#151318</Color>
    <Color x:Key="TabSelectedBackgroundColor">#2D2932</Color>
    <Color x:Key="TabHoverBackgroundColor">#3A3246</Color>
    <Color x:Key="TabSeparatorColor">#6E637E</Color>
    <Color x:Key="TextColor">#EFEEF2</Color>
    <Color x:Key="SubtleTextColor">#B6AFC0</Color>
    <Color x:Key="BorderColor">#585062</Color>
    <Color x:Key="GridLineColor">#36323B</Color>
