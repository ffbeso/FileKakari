<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>FileKakari</AssemblyName>
    <RootNamespace>FileKakari</RootNamespace>
    <ApplicationIcon>Assets\FileKakari.ico</ApplicationIcon>
    <Version>0.2.0-alpha</Version>
    <AssemblyVersion>0.2.0.0</AssemblyVersion>
    <FileVersion>0.2.0.0</FileVersion>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj\**;bin\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Themes\*.xaml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FileKakari.PreviewHost\FileKakari.PreviewHost.csproj" />
  </ItemGroup>

  <Target Name="IncludePreviewHostInPublish" BeforeTargets="ComputeFilesToPublish" Condition="'$(PublishSingleFile)' == 'true' and '$(BuildingPreviewHost)' != 'true'">
    <PropertyGroup>
      <_PreviewHostPublishDir>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\$(IntermediateOutputPath)previewhost_publish\'))</_PreviewHostPublishDir>
    </PropertyGroup>
    <MSBuild Projects="..\FileKakari.PreviewHost\FileKakari.PreviewHost.csproj"
             Targets="Publish"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=$(SelfContained);PublishSingleFile=true;PublishDir=$(_PreviewHostPublishDir);BuildingPreviewHost=true" />
    <ItemGroup>
      <ResolvedFileToPublish Include="$(_PreviewHostPublishDir)FileKakari.PreviewHost.exe">
        <RelativePath>FileKakari.PreviewHost.exe</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>


</Project>
