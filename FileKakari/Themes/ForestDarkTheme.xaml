    <Color x:Key="TabBackgroundColor">#131815</Color>
    <Color x:Key="TabSelectedBackgroundColor">#29322D</Color>
    <Color x:Key="TabHoverBackgroundColor">#32463A</Color>
    <Color x:Key="TabSeparatorColor">#637E6E</Color>
    <Color x:Key="TextColor">#EEF2EF</Color>
    <Color x:Key="SubtleTextColor">#AFC0B6</Color>
