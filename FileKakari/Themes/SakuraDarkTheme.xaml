<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- サクラ / Dark; generated by tools/generate_themes.py -->
    <Color x:Key="AppBackgroundColor">#1A1416</Color>
    <Color x:Key="PanelBackgroundColor">#231D1F</Color>
    <Color x:Key="ControlBackgroundColor">#2E2427</Color>
    <Color x:Key="ControlHoverColor">#432D34</Color>
    <Color x:Key="ControlPressedColor">#5B3743</Color>
    <Color x:Key="ControlDisabledColor">#282224</Color>
    <Color x:Key="HeaderBackgroundColor">#2C2326</Color>
    <Color x:Key="HeaderHoverColor">#412D34</Color>
    <Color x:Key="HeaderGripColor">#7E636C</Color>
    <Color x:Key="HeaderGripHoverColor">#AB8793</Color>
    <Color x:Key="RowBackgroundColor">#231D1F</Color>
    <Color x:Key="RowHoverColor">#39282E</Color>
    <Color x:Key="TabBackgroundColor">#181315</Color>
    <Color x:Key="TabSelectedBackgroundColor">#32292C</Color>
    <Color x:Key="TabHoverBackgroundColor">#463239</Color>
    <Color x:Key="TabSeparatorColor">#7E636C</Color>
    <Color x:Key="TextColor">#F2EEEF</Color>
    <Color x:Key="SubtleTextColor">#C0AFB5</Color>
    <Color x:Key="BorderColor">#625056</Color>
    <Color x:Key="GridLineColor">#3B3235</Color>
    <Color x:Key="SelectionBackgroundColor">#6D243D</Color>
