    <Color x:Key="PanelBackgroundColor">#102517</Color>
    <Color x:Key="ControlBackgroundColor">#242E26</Color>
    <Color x:Key="ControlHoverColor">#2D4332</Color>
    <Color x:Key="ControlPressedColor">#375B40</Color>
    <Color x:Key="ControlDisabledColor">#222824</Color>
    <Color x:Key="HeaderBackgroundColor">#153820</Color>
