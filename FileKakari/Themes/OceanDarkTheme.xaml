    <Color x:Key="RowHoverColor">#283839</Color>
    <Color x:Key="TabBackgroundColor">#131818</Color>
    <Color x:Key="TabSelectedBackgroundColor">#293232</Color>
    <Color x:Key="TabHoverBackgroundColor">#324446</Color>
    <Color x:Key="TabSeparatorColor">#637B7E</Color>
    <Color x:Key="TextColor">#EEF1F2</Color>
    <Color x:Key="SubtleTextColor">#AFBFC0</Color>
    <Color x:Key="BorderColor">#506162</Color>
    <Color x:Key="GridLineColor">#323A3B</Color>
    <Color x:Key="SelectionBackgroundColor">#24676D</Color>
    <Color x:Key="SelectionInactiveBackgroundColor">#364142</Color>
    <Color x:Key="SelectionTextColor">#F7F8F8</Color>
    <Color x:Key="FolderIconColor">#F0BF65</Color>
