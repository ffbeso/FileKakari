    <Color x:Key="ControlDisabledColor">#F0EFF1</Color>
    <Color x:Key="HeaderBackgroundColor">#E9E1F4</Color>
    <Color x:Key="HeaderHoverColor">#E7DFE9</Color>
    <Color x:Key="HeaderGripColor">#9D8AA3</Color>
