<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 標準ブルー / Dark; generated by tools/generate_themes.py -->
    <Color x:Key="AppBackgroundColor">#14171A</Color>
    <Color x:Key="PanelBackgroundColor">#1D1F23</Color>
    <Color x:Key="ControlBackgroundColor">#24282E</Color>
    <Color x:Key="ControlHoverColor">#2D3743</Color>
    <Color x:Key="ControlPressedColor">#37465B</Color>
    <Color x:Key="ControlDisabledColor">#222528</Color>
    <Color x:Key="HeaderBackgroundColor">#23272C</Color>
    <Color x:Key="HeaderHoverColor">#2D3641</Color>
    <Color x:Key="HeaderGripColor">#636E7E</Color>
