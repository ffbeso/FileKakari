<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- ラベンダー / Dark; generated by tools/generate_themes.py -->
    <Color x:Key="AppBackgroundColor">#16141A</Color>
    <Color x:Key="PanelBackgroundColor">#1F1D23</Color>
    <Color x:Key="ControlBackgroundColor">#28242E</Color>
    <Color x:Key="ControlHoverColor">#362D43</Color>
    <Color x:Key="ControlPressedColor">#46375B</Color>
    <Color x:Key="ControlDisabledColor">#252228</Color>
    <Color x:Key="HeaderBackgroundColor">#27232C</Color>
    <Color x:Key="HeaderHoverColor">#352D41</Color>
    <Color x:Key="HeaderGripColor">#6E637E</Color>
    <Color x:Key="HeaderGripHoverColor">#9687AB</Color>
