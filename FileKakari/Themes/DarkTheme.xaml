    <Color x:Key="RowBackgroundColor">#1D1F23</Color>
    <Color x:Key="RowHoverColor">#282F39</Color>
    <Color x:Key="TabBackgroundColor">#131518</Color>
    <Color x:Key="TabSelectedBackgroundColor">#292D32</Color>
    <Color x:Key="TabHoverBackgroundColor">#323B46</Color>
    <Color x:Key="TabSeparatorColor">#636E7E</Color>
    <Color x:Key="TextColor">#EEEFF2</Color>
    <Color x:Key="SubtleTextColor">#AFB6C0</Color>
    <Color x:Key="BorderColor">#505862</Color>
    <Color x:Key="GridLineColor">#32363B</Color>
